# Copy to .env and fill in what you have. Every one of these is optional:
# with none of them set, `make run` drives the whole product against a
# simulated pregnancy. A missing key disables one capability and is logged at
# startup — it never stops the server.
#
# .env itself is gitignored. Keep it that way.

# --- sign-in (Auth0) ------------------------------------------------------
# Unset, every page is open — which is what a hardware demo on a bench wants,
# and what you must not ship. With these set, the record needs a session.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Must match the port you actually listen on, or the callback 404s. The
# server warns at startup when the two disagree.
APP_BASE_URL=http://localhost:3000
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 32  — exactly 32 bytes once decoded (AES-256)
DATA_ENCRYPTION_KEY=

# --- the escalation call (Vapi) -------------------------------------------
# VAPI_API_KEY is the PRIVATE key. The public key is for browser SDKs and
# returns 401 here; the error message says so, because this costs an hour.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_TO_NUMBER=
VAPI_VOICE_ID=

# --- narrative memory (Backboard) -----------------------------------------
BACKBOARD_API_KEY=
# Optional, and worth setting once you have a record worth keeping: the
# assistant is otherwise found by NAME at startup, so renaming the product
# creates a second, empty one and orphans everything written so far.
BACKBOARD_ASSISTANT_ID=

# --- the written note (any OpenAI-compatible endpoint) --------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- the long record (TigerData / Timescale) ------------------------------
TIGER_DATABASE_URL=
