{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "https://35.232.223.194.nip.io/dashboard",
      "permanent": false
    },
    {
      "source": "/history",
      "destination": "https://35.232.223.194.nip.io/history",
      "permanent": false
    },
    {
      "source": "/healthcare",
      "destination": "https://35.232.223.194.nip.io/healthcare",
      "permanent": false
    },
    {
      "source": "/medications",
      "destination": "https://35.232.223.194.nip.io/medications",
      "permanent": false
    },
    {
      "source": "/settings",
      "destination": "https://35.232.223.194.nip.io/settings",
      "permanent": false
    },
    {
      "source": "/report",
      "destination": "https://35.232.223.194.nip.io/report",
      "permanent": false
    }
  ]
}
